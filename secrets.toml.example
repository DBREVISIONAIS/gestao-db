# ============================================================
# SECRETS — Gestão DB
#
# Em produção este conteúdo vai em Settings > Secrets do Streamlit.
# Em uso local, salvar como .streamlit/secrets.toml e não versionar.
# ============================================================

# ------------------------------------------------------------
# A ÚNICA planilha que o painel lê é a auxiliar.
# A planilha principal não é compartilhada com a conta de serviço
# e o painel não tem como acessá-la.
# É o trecho da URL entre /d/ e /edit.
# ------------------------------------------------------------
ID_PLANILHA_AUXILIAR = "1AbCdEfGhIjKlMnOpQrStUvWxYz_EXEMPLO"

# Opcional. Só preencher se o LOG_ALTERACOES for para uma terceira
# planilha, separada dos espelhos. Em branco, o painel procura o log
# dentro da própria auxiliar, que é o padrão.
# ID_PLANILHA_LOGS = "1OutroIdSomenteDeLog_EXEMPLO"

# ------------------------------------------------------------
# ACESSO — MODO SENHA ÚNICA
#
# Quem digitar esta senha vê todas as telas.
# Gerar o hash com:  python gerar_hash.py
# ------------------------------------------------------------
SENHA_ACESSO  = "COLE_O_HASH_SHA256_AQUI"
NOME_EXIBICAO = "Dutra Bitencourt"

# ------------------------------------------------------------
# DESEMPENHO
#
# CACHE_TTL_SEGUNDOS  tempo até o painel reler a planilha auxiliar.
# MAX_LINHAS_LOG      quantas linhas finais do LOG_ALTERACOES são
#                     carregadas. O histórico completo continua na
#                     planilha; o painel só não puxa tudo para a tela.
# ------------------------------------------------------------
CACHE_TTL_SEGUNDOS = 120
MAX_LINHAS_LOG     = 30000

# ------------------------------------------------------------
# Conta de serviço do Google Cloud, com papel de Visualizador
# APENAS na planilha auxiliar. Copiar os campos do JSON.
# ------------------------------------------------------------
[gcp_service_account]
type = "service_account"
project_id = "gestao-db"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\nLINHA1\nLINHA2\n-----END PRIVATE KEY-----\n"
client_email = "painel-gestao-db@gestao-db.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"

# ============================================================
# OPCIONAL — ACESSO POR USUÁRIO
#
# Só usar se a equipe passar a acessar o painel. A existência de
# qualquer usuário desliga o modo de senha única.
# ============================================================

# [usuarios.arthur]
# nome = "Arthur"
# senha_sha256 = "..."
# perfil = "ADMIN"
#
# [perfis.JURIDICO]
# paginas = ["Visão geral", "Prazos", "Clientes", "Histórico e auditoria"]
# somente_proprios = true
# ver_financeiro = false
